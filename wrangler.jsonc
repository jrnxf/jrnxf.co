{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jrnxf-co",
  "compatibility_date": "2026-04-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  // www.jrnxf.co is a 301 redirect to the apex, managed as a DNS record +
  // redirect rule in the Cloudflare zone - do not add it as a custom domain
  // here, the attach fails against the existing records.
  "routes": [{ "pattern": "jrnxf.co", "custom_domain": true }],
}
