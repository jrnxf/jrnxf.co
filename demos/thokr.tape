# Re-record with: demos/render.sh thokr   (needs vhs, ffmpeg and thokr on PATH)
Output public/work/thokr.mp4
Set Shell "bash"
Set FontSize 22
Set Width 960
Set Height 540
Set Padding 28
Set Framerate 30
Set TypingSpeed 85ms
Set Theme { "name": "Cursor Dark", "background": "#141414", "foreground": "#e4e4e4", "cursor": "#e4e4e4", "selection": "#404040", "black": "#242424", "red": "#fc6b83", "green": "#3fa266", "yellow": "#d2943e", "blue": "#81a1c1", "magenta": "#b48ead", "cyan": "#88c0d0", "white": "#e4e4e4", "brightBlack": "#6a6a6a", "brightRed": "#fc6b83", "brightGreen": "#70b489", "brightYellow": "#f1b467", "brightBlue": "#87a6c4", "brightMagenta": "#b48ead", "brightCyan": "#88c0d0", "brightWhite": "#e4e4e4" }

Hide
Type "export PS1='$ ' && clear" Enter
Type "thokr -p 'small sharp tools made at a desk by the sea'" Enter
Sleep 800ms
Show
Sleep 500ms
Set TypingSpeed 110ms
Type "small sharp tools made at a desk by the sea"
Sleep 2500ms
