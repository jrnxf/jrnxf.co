# Re-record with: demos/render.sh fsrx   (needs vhs, ffmpeg and fsrx on PATH)
Output public/work/fsrx.mp4
Set Shell "bash"
Set FontSize 22
Set Width 960
Set Height 540
Set Padding 28
Set Framerate 30
Set TypingSpeed 60ms
Set Theme { "name": "Cursor Dark", "background": "#141414", "foreground": "#e4e4e4", "cursor": "#e4e4e4", "selection": "#404040", "black": "#242424", "red": "#fc6b83", "green": "#3fa266", "yellow": "#d2943e", "blue": "#81a1c1", "magenta": "#b48ead", "cyan": "#88c0d0", "white": "#e4e4e4", "brightBlack": "#6a6a6a", "brightRed": "#fc6b83", "brightGreen": "#70b489", "brightYellow": "#f1b467", "brightBlue": "#87a6c4", "brightMagenta": "#b48ead", "brightCyan": "#88c0d0", "brightWhite": "#e4e4e4" }

Hide
Type "export PS1='$ ' && clear" Enter
Type "cat > /tmp/slow-mornings.txt <<'EOF'" Enter
Type "The best tools get out of your way. A good terminal" Enter
Type "program starts at once, does one thing well, and" Enter
Type "leaves you alone to think. Most of the work of making" Enter
Type "something small and sharp is deciding what to leave" Enter
Type "out, and then having the patience to leave it out" Enter
Type "again when the next good idea arrives." Enter
Type "EOF" Enter
Type "clear && fsrx /tmp/slow-mornings.txt" Enter
Sleep 700ms
Show
Sleep 5500ms
